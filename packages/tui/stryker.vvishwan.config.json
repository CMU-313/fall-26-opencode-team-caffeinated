{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test test/feature-plugins/intro.test.tsx -t \"^R[1-4]:\""
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/feature-plugins/home/intro.tsx:135-138",
    "src/feature-plugins/home/intro.tsx:215-222",
    "src/feature-plugins/home/intro.tsx:225-226",
    "src/feature-plugins/home/intro.tsx:232-232",
    "src/feature-plugins/home/intro.tsx:338-343",
    "src/feature-plugins/home/intro.tsx:393-422"
  ],
  "concurrency": 2,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/vvishwan.html" },
  "tempDirName": ".stryker-tmp"
}
