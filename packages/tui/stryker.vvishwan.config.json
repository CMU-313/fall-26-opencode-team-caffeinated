{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test test/feature-plugins/intro.test.tsx -t \"^R[1-4]:\""
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/feature-plugins/home/intro.tsx:119-122",
    "src/feature-plugins/home/intro.tsx:207-214",
    "src/feature-plugins/home/intro.tsx:217-218",
    "src/feature-plugins/home/intro.tsx:224-224",
    "src/feature-plugins/home/intro.tsx:330-335",
    "src/feature-plugins/home/intro.tsx:385-411"
  ],
  "concurrency": 2,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/vvishwan.html" },
  "tempDirName": ".stryker-tmp"
}
